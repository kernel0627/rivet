# Copy this file to .env and fill in the secret values. Rivet automatically
# loads .env from the selected workspace. Existing process environment
# variables take precedence. Secrets are not persisted in configuration or trace.

# Model provider
RIVET_PROVIDER=openai
RIVET_MODEL=
RIVET_BASE_URL=https://api.openai.com/v1

# The variable named by RIVET_API_KEY_ENV contains the actual provider secret.
RIVET_API_KEY_ENV=RIVET_API_KEY
RIVET_API_KEY=

# Model request policy
RIVET_TIMEOUT_SECONDS=120
RIVET_MAX_RETRIES=2

# Runtime budgets
RIVET_MAX_TURNS=30
RIVET_MAX_MODEL_CALLS=60
RIVET_MAX_TOOL_EXECUTIONS=200
RIVET_MAX_INPUT_TOKENS=100000

# Optional: keep Rivet state in a custom directory outside the target project.
# RIVET_STATE_HOME=/absolute/path/to/rivet-state

# Optional: override the user configuration directory.
# RIVET_CONFIG_HOME=/absolute/path/to/rivet-config
